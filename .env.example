# Copy this file to `.env` and paste in your own values.
# Vite only exposes variables that start with VITE_.
# These are public client-side identifiers, not secrets — the real protection is
# the Firestore security rules in firestore.rules.
#
# Never put an admin service-account private key in this file. The app only ever
# uses the client SDK and signs in as a normal user.

# --- Firebase (required — the app stores everything in Cloud Firestore) ------
# Firebase console > Project settings > Your apps > Web app > SDK setup
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# --- Google Calendar (optional, for reminders) -------------------------------
# Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web)
# Leave blank to keep the calendar features switched off.
VITE_GOOGLE_CLIENT_ID=

# --- Local development only --------------------------------------------------
# Set to true in .env.local to talk to the Firebase emulators (npm run emulators)
# instead of your real project. Leave unset for production.
VITE_FIREBASE_EMULATOR=
